{
  "name": "p5.keyed",
  "version": "1.0.0",
  "description": "Keyframe animation for p5.js: set values at a few points in time and Keyed blends everything in between.",
  "author": "Dominique Schmitz (http://www.domizai.ch)",
  "license": "LGPL-2.1",
  "type": "module",
  "main": "lib/p5.keyed.js",
  "module": "lib/p5.keyed.esm.js",
  "types": "lib/types/p5.keyed.d.ts",
  "files": [
    "lib",
    "license.txt"
  ],
  "keywords": [
    "p5",
    "p5.js",
    "p5js",
    "addon",
    "animation",
    "keyframes",
    "easing",
    "timeline",
    "tween",
    "processing"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "node build.mjs",
    "build:types": "tsc -p tsconfig.build.json && node fix-types.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "p5": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "p5": "^2.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/domizai/p5.keyed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domizai/p5.keyed.git"
  },
  "bugs": {
    "url": "https://github.com/domizai/p5.keyed/issues"
  },
  "jsdelivr": "lib/p5.keyed.min.js",
  "unpkg": "lib/p5.keyed.min.js",
  "exports": {
    ".": {
      "types": "./lib/types/p5.keyed.d.ts",
      "import": "./lib/p5.keyed.esm.js",
      "default": "./lib/p5.keyed.js"
    },
    "./package.json": "./package.json"
  }
}
